# Copy this file to `.env` and fill in your real values.
# NEVER commit the real .env — it contains your bot token.

# From https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=paste_your_bot_token_here

# Optional: a server ID used for instant slash-command syncing while developing.
# Global commands can take up to an hour to appear; guild commands appear instantly.
# Right-click your server -> Copy Server ID (needs Developer Mode on).
DEV_GUILD_ID=

# Where the SQLite file lives. Leave as-is unless you know why you're changing it.
DATABASE_PATH=data/bot.db
